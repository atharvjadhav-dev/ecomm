# ==============================================================================
# Docker Compose Environment Configuration Template
# Copy this file to .env.docker and adjust values as needed.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_local_postgres_password
POSTGRES_DB=medusa_db

# Host Port Mappings
# Default co-existence ports (use these when local node is running on 9000/8000):
MEDUSA_PORT=9001
STOREFRONT_PORT=8001

# Everyday standard ports (use when local dev server is stopped):
# MEDUSA_PORT=9000
# STOREFRONT_PORT=8000

# Backend Security Secrets (REQUIRED: Generate strong random 64-byte hex secrets in production)
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
COOKIE_SECRET=change_me_cookie_secret_at_least_32_chars

# Cookie Security (set to false for local HTTP container testing; must be true or omitted for HTTPS production)
COOKIE_SECURE=false

# CORS Configurations
STORE_CORS=http://localhost:8000,http://localhost:8001,http://127.0.0.1:8000,http://127.0.0.1:8001,http://storefront:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000,http://localhost:9001
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:9001,http://localhost:8000,http://localhost:8001,http://storefront:8000

# Storefront API Configuration (Matched by initial-data-seed.ts on initial DB seed, or copy from Medusa Admin -> Settings -> Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_with_medusa_publishable_key
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9001
NEXT_PUBLIC_BASE_URL=http://localhost:8001
NEXT_PUBLIC_DEFAULT_REGION=dk
